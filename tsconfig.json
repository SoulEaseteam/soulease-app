{
  "compilerOptions": {
    /* ---------- Basic ---------- */
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,

    /* ---------- Module Resolution ---------- */
    "module": "ESNext",
    "moduleResolution": "Node",   // ✅ ใช้ Node resolution แทน Bundler จะเข้ากับ Vite + TS
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* ---------- Paths Alias ---------- */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@pages/*": ["src/pages/*"],
      "@providers/*": ["src/providers/*"],
      "@layouts/*": ["src/components/layouts/*"],
      "@hooks/*": ["src/hooks/*"],
      "@utils/*": ["src/utils/*"],
      "@lib/*": ["src/lib/*"],
      "@data/*": ["src/data/*"],
      "@types/*": ["src/types/*"],
      "@services/*": ["src/types/services/*"],
      "@assets/*": ["src/assets/*"]
    },

    /* ---------- Types ---------- */
    "types": ["vite/client", "google.maps"],

    /* ---------- Extra ---------- */
    "verbatimModuleSyntax": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/scripts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}