rules_version = '2';

// 🆕 Round 28s280 (founder: "แกลเลอรี — อัปโหลดเพิ่ม/ลบรูปได้ จากมือถือ") —
// therapist gallery photo uploads. Firebase Storage wasn't configured
// before this round (the storage export was dropped in 28s105 for having
// zero consumers). These rules mirror firestore.rules' admin model:
// admin = an entry exists in /admins/{uid}.
service firebase.storage {
  match /b/{bucket}/o {

    // Therapist gallery images — publicly readable (they're shown on the
    // customer-facing site), writable/deletable ONLY by an admin, capped
    // at 10 MB and restricted to image/* content types.
    match /therapists/{therapistId}/gallery/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Everything else: locked down.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
