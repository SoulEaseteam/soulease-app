rules_version = '2';

// 🆕 Round 28s280 (founder: "แกลเลอรี — อัปโหลดเพิ่ม/ลบรูปได้ จากมือถือ") —
// therapist gallery photo uploads. Firebase Storage wasn't configured
// before this round (the storage export was dropped in 28s105 for having
// zero consumers). These rules mirror firestore.rules' admin model:
// admin = an entry exists in /admins/{uid}.
service firebase.storage {
  match /b/{bucket}/o {

    // Therapist gallery images — publicly readable (they're shown on the
    // customer-facing site), writable by any AUTHENTICATED user, capped at
    // 15 MB and restricted to image/* content types.
    //
    // 🆕 Round 28s281 — dropped the `firestore.exists(/admins/{uid})`
    // cross-service admin check that 28s280 used: it denied every real
    // admin upload ("storage/unauthorized") in practice — the Storage→
    // Firestore cross-service read wasn't resolving. Auth-only is an
    // acceptable posture here because the real exposure gate is elsewhere:
    // a file only appears on a public profile once its URL is written into
    // that therapist's `gallery` array, and firestore.rules already limits
    // therapist-doc writes to admins. So a non-admin upload here is at
    // worst an orphan file (never shown anywhere), capped at 15 MB, by one
    // of the app's very few account holders. Tighten to true admin-only
    // later via an `admin:true` custom claim (needs a Cloud Function) if
    // storage-fill abuse ever shows up.
    // 🆕 Round 28s284 — broadened from .../gallery/** to .../** so profile
    // photos (therapists/{id}/profile/**) uploaded from the avatar picker
    // are covered too, alongside gallery/**.
    match /therapists/{therapistId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // 🆕 Round 28s301 (founder: "ราคา & บริการ เพิ่ม เมนูได้") — images for
    // admin-created custom services. Same posture as therapist images:
    // public read (shown on the customer booking menu), authenticated
    // write, image-only, size-capped.
    match /services/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // 🆕 Round 28r60 (founder — "Bundle UI polish · photo + category tags")
    // — hero images for admin-created Bundle Packages. Same posture as the
    // therapist + services paths: public read (shown on the customer
    // BundleSection card), authenticated image-only write, 15MB cap. Same
    // rationale as 28s281 for auth-only writes — the exposure gate is the
    // Firestore-side `bundles.{id}.imageUrl` field on `publicRules`, which
    // firestore.rules restricts to admins.
    match /bundles/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // 🆕 Round 28x.124 (founder: "ถึงแล้ว — ให้พนักงานถ่ายรูปจุดที่รอลูกค้า
    // ส่งแอดมิน") — the arrival proof photo a practitioner takes when she
    // reaches the meeting point. Deliberately NOT `allow read: if true`,
    // unlike every path above: those are marketing images meant for the
    // public site, this is a photo of where a specific guest is waiting.
    // Signed-in read only. The Cloud Function still reaches it to forward to
    // Telegram because getDownloadURL()'s token bypasses these rules — the
    // rule's job here is to stop the path being publicly browsable.
    match /jobArrivals/{bookingId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Everything else: locked down.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
