{
  "compilerOptions": {
    "lib": ["es2020", "dom"],
    "module": "commonjs",
    "target": "es2020",

    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "sourceMap": true,

    "outDir": "lib",
    "rootDir": "src",

    "noImplicitAny": false,
    "resolveJsonModule": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },

  "compileOnSave": true,

  "include": ["src"],
  "exclude": ["node_modules", "lib"]
}