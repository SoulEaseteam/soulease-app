rules_version = '2';

// 🔐 SunRed Firestore Rules — Round 28s1 (founder 2026-05-30)
//
// Round 28s1 — security hardening (audit found critical PII leak):
//   • bookings: public LIST closed (was open) — now owner/therapist/admin
//     filtered. Single-doc GET still open so guest success page works
//     by random doc ID.
//   • users: public READ closed; CREATE/UPDATE banned from touching `role`
//     (was open — any customer could self-promote to admin).
//   • reviews.CREATE now requires auth + matching userId + status='pending'
//     (was anonymous — anyone could spam fake reviews via SDK).
//   • notifications: locked to per-user read/create/update with hasOnly()
//     on read flag (was fully public — phishing-link rewrite risk).
//   • bookings.UPDATE field whitelist per role (customer can only cancel;
//     therapist can only update status/arrival; admin unrestricted).
//
// Goal: lock therapist self-service to a small set of "safe" fields,
//       keep sensitive things (rating / reviews / totalSessions /
//       isBooked / credentials / badge) as admin-only writes, and
//       still let customers read the public catalog.
//
// Roles
//   • Admin   — entry exists in /admins/{uid}.
//   • Therapist owner — auth.uid matches the doc id, OR the doc's
//                       `uid` field, OR the doc's `email` field.
//   • Customer / guest — anyone else (signed-in or not).
//
// MVP-friendly: bookings/reviews still allow public-create with
// minimal validation so guest checkout works. Tighten when App Check
// + Anonymous Auth are fully wired.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ────────────────────────────────────────────────────
    function isSignedIn() { return request.auth != null; }

    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** True if the signed-in user owns this therapist doc.
     *  Matches by docId, by `uid` field, or by `email` field. */
    function isTherapistOwner(therapistId) {
      return isSignedIn() && (
        request.auth.uid == therapistId ||
        (resource.data.uid is string && resource.data.uid == request.auth.uid) ||
        (resource.data.email is string &&
         request.auth.token.email is string &&
         resource.data.email == request.auth.token.email)
      );
    }

    /** Whitelist of fields a therapist may edit on their own profile.
     *  Anything outside this list = admin-only. */
    function therapistEditableKeys() {
      return [
        // status / availability self-service
        'statusOverride', 'isHoliday', 'busyUntil', 'activeBooking',
        // working hours
        'startTime', 'endTime',
        // location
        'currentLocation', 'homeLocation', 'lat', 'lng', 'area',
        // media
        'image', 'gallery',
        // soft profile
        'features', 'specialty', 'servicesAvailable', 'services',
        'bios', 'bioGeneratedAt',
        // 🆕 Round 28b27 — Telegram notification opt-in. Therapist
        //   themselves DM the bot to register and updates this field.
        'telegramChatId',
        // bookkeeping (audit metadata — read by Functions trigger)
        'updatedAt', 'updatedBy'
      ];
    }

    /** True if the proposed update only touches whitelisted keys. */
    function therapistUpdateIsSelfEditable() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly(therapistEditableKeys());
    }

    // ── admins ─────────────────────────────────────────────────────
    // Self-read is allowed (so LoginPage can check isAdmin via direct
    // doc read without leaking other admins' info), peer-admin can
    // read the full collection. Writes only via Firebase Console
    // (or an Admin SDK script with service account creds).
    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      allow write: if false;
    }

    // ── users (customer profiles) ──────────────────────────────────
    // Round 28s1: tightened.
    //  • READ: owner + admin only (was public — leaked phone/email/role).
    //  • CREATE: owner only, and `role` must be 'user' or absent
    //    (was open — attacker could pre-create users/<future-uid> with
    //    role:'admin' before signup; setRoleOnSignup merges and the
    //    malicious role wins).
    //  • UPDATE: owner can only change a whitelist of safe profile
    //    fields. `role` is explicitly NOT in the list — closes the
    //    self-promotion-to-admin path that the client trust model relied
    //    on. Admin SDK + Cloud Functions bypass these and remain free.
    function userEditableKeys() {
      return ['displayName', 'phone', 'photoURL', 'language', 'updatedAt'];
    }
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
                    && (!('role' in request.resource.data)
                        || request.resource.data.role == 'user');
      allow update: if isAdmin()
                    || (isOwner(userId)
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(userEditableKeys()));
      allow delete: if isAdmin();
    }

    // ── therapists ─────────────────────────────────────────────────
    // Public read (catalog). Self-service updates are limited to a
    // whitelist of fields; everything else is admin-only.
    match /therapists/{therapistId} {
      allow read: if true;
      allow create: if isAdmin();

      allow update: if isAdmin() ||
                    (isTherapistOwner(therapistId) &&
                     therapistUpdateIsSelfEditable());

      allow delete: if isAdmin();
    }

    // ── services ───────────────────────────────────────────────────
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── bookings ───────────────────────────────────────────────────
    // Round 28s1: tightened. Was `allow read: if true` which exposed
    // every customer's phone/address/hotel room/name to anonymous
    // callers. Now:
    //  • GET (single doc by ID) stays public — BookingSuccessPage
    //    needs anonymous read after guest checkout, and Firestore
    //    auto IDs (20 char base64-ish) are not feasibly guessable.
    //  • LIST/query restricted to owner/therapist/admin. Client
    //    queries (BookingHistoryPage, useTherapistBookings, etc.)
    //    MUST filter by `userId == auth.uid` or `therapistId ==
    //    auth.uid` so each returned doc satisfies the rule.
    //  • CREATE stays open for guest checkout but status whitelist
    //    keeps customers from creating pre-marked-paid bookings.
    //  • UPDATE: customer can only touch a cancel-related field
    //    whitelist (no flipping their own booking to status=paid
    //    or modifying totalPrice). Therapist can only update
    //    operational fields (status/arrived/completed). Admin
    //    unrestricted.
    function customerBookingEditableKeys() {
      return ['status', 'note', 'cancelledAt', 'cancelReason', 'updatedAt'];
    }
    function therapistBookingEditableKeys() {
      return ['status', 'arrivedAt', 'completedAt', 'therapistNote', 'updatedAt'];
    }
    match /bookings/{bookingId} {
      allow get: if true;
      allow list: if isAdmin()
                  || (isSignedIn() && resource.data.userId == request.auth.uid)
                  || (isSignedIn() && resource.data.therapistId == request.auth.uid);
      allow create: if request.resource.data.status in ['pending', 'confirmed'];
      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.userId == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(customerBookingEditableKeys()))
                    || (isSignedIn()
                        && resource.data.therapistId == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(therapistBookingEditableKeys()));
      allow delete: if isAdmin();
    }

    // ── reviews ────────────────────────────────────────────────────
    // Round 28s1: tightened. Was open create with only rating-range
    // check — anyone could spam fake 5★ self-praise or 1★ competitor
    // sabotage via the SDK. Now requires sign-in, matching userId,
    // forced status='pending' (so customer can't auto-approve their
    // own review), and a comment size cap to prevent quota abuse.
    // ReviewPage.tsx already gates UX behind login + completed-booking;
    // this just makes the rules match the intent.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.status == 'pending'
                    && (!('comment' in request.resource.data)
                        || (request.resource.data.comment is string
                            && request.resource.data.comment.size() <= 2000));
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── notifications ──────────────────────────────────────────────
    // Round 28s1: tightened. Was fully public — any attacker could
    // rewrite a victim's `link` field to a phishing URL, or dump
    // every notification in the system. Now:
    //  • READ: owner + admin only.
    //  • CREATE: only by the owning user (BookingFlowPage writes
    //    {userId: user.uid, ...} after auth check). Cloud Functions
    //    use admin SDK and bypass.
    //  • UPDATE: owner can only flip the read flag — link/title/
    //    content stay immutable.
    match /notifications/{notifId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
                    || (isSignedIn()
                        && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.userId == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(['read', 'readAt']));
      allow delete: if isAdmin();
    }

    // ── blocked devices / admin settings ───────────────────────────
    match /blockedDevices/{deviceId} {
      allow read, write: if isAdmin();
    }

    match /adminSettings/{settingId} {
      allow read, write: if isAdmin();
    }

    // ── audit log (write-only from server, read by admin) ─────────
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // populated by Cloud Functions only
    }

    // 🆕 Round 28b21 (founder 2026-05-04) — Phase 3 of conversion plan.
    // ── adminPresence (heartbeat doc for "Admin online" badge) ────
    // Single doc `adminPresence/global` written by AdminLayout every
    // 30 seconds. Public read so customer surfaces (BookingSuccess,
    // HeroSection) can light up the green pill. Only signed-in admins
    // may write; rules enforce server-side accuracy.
    match /adminPresence/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 🆕 Round 28b21 — Phase 4 of conversion plan.
    // ── abandoned_bookings (cart abandonment recovery) ────────────
    // Customer browser writes a partial booking when they fill the
    // contact form but haven't submitted. The recoverAbandonedBookings
    // scheduled function reads docs >15 min stale and pings admin.
    // Public create + self-update so guest carts work (no auth at
    // checkout-fill stage). Admin reads/lists for follow-up.
    match /abandoned_bookings/{cartId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update: if true; // browser bumps lastActivityAt as user types
      allow delete: if isAdmin();
    }

    // 🆕 Round 28b21 — Phase 3.
    // ── telegramLogs (server-only audit trail) ────────────────────
    match /telegramLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // populated by Cloud Functions only
    }

    // 🆕 Round 28r18 (founder 2026-05-07) — booking-flow error capture.
    // ── booking_errors (admin triage of failed reservations) ──────
    // Customer browser writes one doc per failed booking submit so
    // admin can see WHY "tried to reserve online but doesn't work"
    // without needing repro steps. Public CREATE so anonymous guests
    // can log; admin-only READ; immutable (no update/delete) so the
    // log can't be tampered with.
    match /booking_errors/{eventId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    // 🆕 Round 28r13 (founder 2026-05-06) — funnel analytics.
    // ── analytics_events (self-hosted funnel tracking) ────────────
    // Five-event funnel: home_view / service_view / booking_start /
    // booking_complete / concierge_chat_open. Public CREATE so guest
    // sessions can fire events without auth. Validates the event name
    // against the allow-list to keep the collection clean. Immutable
    // (no update/delete) so the audit trail can't be tampered with.
    // Only admins read — funnel queries should aggregate on the
    // admin side, never expose event timeline to customers.
    match /analytics_events/{eventId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.event in [
        'home_view',
        'service_view',
        'booking_start',
        'booking_complete',
        'concierge_chat_open'
      ];
      allow update, delete: if false;
    }

    // ── default deny ───────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
