rules_version = '2';

// 🔐 SunRed Firestore Rules — Round 28s1 (founder 2026-05-30)
//
// Round 28s1 — security hardening (audit found critical PII leak):
//   • bookings: public LIST closed (was open) — now owner/therapist/admin
//     filtered. Single-doc GET still open so guest success page works
//     by random doc ID.
//   • users: public READ closed; CREATE/UPDATE banned from touching `role`
//     (was open — any customer could self-promote to admin).
//   • reviews.CREATE now requires auth + matching userId + status='pending'
//     (was anonymous — anyone could spam fake reviews via SDK).
//   • notifications: locked to per-user read/create/update with hasOnly()
//     on read flag (was fully public — phishing-link rewrite risk).
//   • bookings.UPDATE field whitelist per role (customer can only cancel;
//     therapist can only update status/arrival; admin unrestricted).
//
// Goal: lock therapist self-service to a small set of "safe" fields,
//       keep sensitive things (rating / reviews / totalSessions /
//       isBooked / credentials / badge) as admin-only writes, and
//       still let customers read the public catalog.
//
// Roles
//   • Admin   — entry exists in /admins/{uid}.
//   • Therapist owner — auth.uid matches the doc id, OR the doc's
//                       `uid` field, OR the doc's `email` field.
//   • Customer / guest — anyone else (signed-in or not).
//
// MVP-friendly: bookings/reviews still allow public-create with
// minimal validation so guest checkout works. Tighten when App Check
// + Anonymous Auth are fully wired.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ────────────────────────────────────────────────────
    function isSignedIn() { return request.auth != null; }

    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ── assigned practitioner (28x.66) ────────────────────────────
    // A booking's `therapistId` is the therapist's DOC id ("XingXingSunRed"),
    // written by the admin panel and treated as a doc id by every Cloud
    // Function. The old rule compared it to `request.auth.uid` — two different
    // identifiers — so a practitioner could never read her own jobs. Proven by
    // tests/rules.test.mjs, which failed on exactly these two cases before this
    // helper existed.
    //
    // The booking now carries `therapistUid` (stamped server-side on create and
    // on reassignment) so the comparison is uid-to-uid, with no extra document
    // read inside the rule — a get() here would run per document scanned in a
    // list query and hit the rules read limit.
    function isAssignedTherapist() {
      return isSignedIn()
             && resource.data.therapistUid is string
             && resource.data.therapistUid == request.auth.uid;
    }

    // ── reserved shop identity (28x.60) ───────────────────────────
    // Founder: "บล๊อค ชื่อ และเบอร์ นี้ ห้าม ใครแอบอ้าง" — nobody may write the
    // shop's own name or number onto a booking, profile or review. A guest
    // "SunRed" with the shop's number on a 2am dispatch card is the exact
    // shape a social-engineering attempt takes against an outcall business.
    //
    // Rules-language has no phone normalisation, so this catches the
    // CANONICAL forms only: any string containing the subscriber digits
    // (covers 0634350987, +66634350987, 66634350987) and any casing of
    // "sunred". Separator-laden variants ("063-435-0987") are caught by the
    // client check in src/config/reservedIdentity.ts, which normalises
    // properly. Coarse here, but unforgeable — the client check is not.
    //
    // ⚠️ KEEP IN SYNC with src/config/reservedIdentity.ts.
    // Both are matches() — deliberately no anchors, so a substring hit is
    // enough and a typo can't accidentally widen this into a deny-all.
    function isReservedName(v) {
      return v is string && v.lower().matches('.*sunred.*');
    }
    function isReservedPhone(v) {
      return v is string && v.matches('.*634350987.*');
    }
    /** True when an incoming write claims the shop's identity. Admins are
     *  exempt — View's own account legitimately carries both. */
    function claimsReservedIdentity(d) {
      return !isAdmin() && (
        (('contactName'  in d) && isReservedName(d.contactName))
        || (('customerName' in d) && isReservedName(d.customerName))
        || (('displayName'  in d) && isReservedName(d.displayName))
        || (('username'     in d) && isReservedName(d.username))
        || (('userName'     in d) && isReservedName(d.userName))
        || (('phone'        in d) && isReservedPhone(d.phone))
      );
    }

    // ── booking payload sanity (28x.107) ──────────────────────────
    // Founder security audit: "หากถูกเจาะ หรือโจมตี". Booking create is
    // intentionally open to logged-out guests — that is the funnel, and
    // gating it behind sign-up would cost real reservations. What was
    // missing is any bound on WHAT that open door accepts. A scripted
    // flood only had to include status:'pending'; every other field, and
    // the document's total size, was free.
    //
    // Caps below are ~10x the largest real booking observed in production,
    // so no genuine guest can hit them, while a spam script loses the
    // ability to make each write large. Nothing here tries to detect a
    // "fake" booking — that judgement is the concierge-confirm step's job
    // (founder: phone numbers alone can't identify anyone), and no rule
    // can do it.
    function strOk(d, k, max) {
      return !(k in d) || d[k] == null
             || (d[k] is string && d[k].size() <= max);
    }
    function isSaneBookingPayload(d) {
      // 🚨 Round 28x.116 HOTFIX — the 28x.107 comment above claimed 60 was
      //   "~10x the largest real booking observed," but the real customer
      //   BookingFlowPage.tsx addDoc payload is 73 top-level keys (counted
      //   directly from source: 68 literal fields + 5 from ...bookingAuthor()).
      //   Every non-admin booking create has been silently rejected by this
      //   rule since it shipped — admin-created bookings bypass via isAdmin()
      //   and looked fine, masking it. Founder screenshot: a real guest
      //   (Almahanad) couldn't complete checkout; she had to re-create the
      //   booking manually via /admin/bookings/add. 100 gives real headroom
      //   above the measured 73 without reopening the key-bloat concern the
      //   cap exists for.
      return d.keys().size() <= 100
             // Phone is the ONE field required outright: it is what the
             // concierge works from, and every real create path writes it.
             && d.phone is string
             && d.phone.size() >= 6 && d.phone.size() <= 24
             // therapistId / serviceId are bounded but NOT required — the
             // admin panel can open a reservation before either is decided,
             // and a rule that assumes the happy path would block real work.
             && strOk(d, 'therapistId', 64)
             && strOk(d, 'serviceId', 64)
             // Free text — the only places a payload can grow without limit.
             && strOk(d, 'note', 1000)
             && strOk(d, 'address', 500)
             && strOk(d, 'addressDetails', 500)
             && strOk(d, 'addressNote', 500)
             && strOk(d, 'locationName', 200)
             && strOk(d, 'meetingPoint', 300)
             && strOk(d, 'contactName', 120)
             && strOk(d, 'discountCode', 64);
    }

    /** True if the signed-in user owns this therapist doc.
     *  Matches by docId, by `uid` field, or by `email` field. */
    function isTherapistOwner(therapistId) {
      return isSignedIn() && (
        request.auth.uid == therapistId ||
        (resource.data.uid is string && resource.data.uid == request.auth.uid) ||
        (resource.data.email is string &&
         request.auth.token.email is string &&
         resource.data.email == request.auth.token.email)
      );
    }

    /** Whitelist of fields a therapist may edit on their own profile.
     *  Anything outside this list = admin-only. */
    function therapistEditableKeys() {
      return [
        // status / availability self-service
        'statusOverride', 'isHoliday', 'busyUntil', 'activeBooking',
        // working hours
        'startTime', 'endTime',
        // location
        'currentLocation', 'homeLocation', 'lat', 'lng', 'area',
        // media
        'image',
        // soft profile
        // 🆕 28x.96 — 'gallery' REMOVED from this whitelist. New photos now
        //   go through galleryRequests (admin approval) per founder: "ทุกรูป
        //   ที่อัปโหลดใหม่จะถูกตรวจสอบผ่านแอดมินก่อนเสมอ" — only an admin
        //   (isAdmin() bypasses this whitelist entirely, see the `update`
        //   rule below) can write the live `gallery` array now.
        'features', 'specialty', 'servicesAvailable', 'services',
        'bios', 'bioGeneratedAt',
        // 🆕 28x.96 (founder Home quick-menu: "Languages · ภาษา") — was
        //   admin-only; no self-service surface needed it before.
        'languageSkills',
        // 🆕 Round 28b27 — Telegram notification opt-in. Therapist
        //   themselves DM the bot to register and updates this field.
        'telegramChatId',
        // 🆕 Round 28x.122 (founder: "Therapists แจ้งสถานะพนักงานเข้าสู่ระบบ")
        //   — presence heartbeat written by StaffLayout while she has the
        //   staff app open. Throttled client-side to one write / 5 min, and
        //   in AUDIT_IGNORE_KEYS so it never reaches the audit log or the
        //   Telegram staff-activity feed.
        'lastSeenAt',
        // 🆕 Round 28x.127 (founder: "ให้แจ้ง 2 อันนี้ด้วย") — stamped once by
        //   LoginPage on a successful staff sign-in. Unlike lastSeenAt this is
        //   NOT in AUDIT_IGNORE_KEYS: a login is worth an audit row, and the
        //   Functions trigger turns it into the "เข้าสู่ระบบ" Telegram notice.
        'lastLoginAt',
        // bookkeeping (audit metadata — read by Functions trigger)
        'updatedAt', 'updatedBy'
      ];
    }

    /** True if the proposed update only touches whitelisted keys. */
    function therapistUpdateIsSelfEditable() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly(therapistEditableKeys());
    }

    // 🆕 Round 28x.96 — a therapist may remove her own gallery photos
    //   instantly (no approval needed to take something DOWN), but may
    //   never ADD one this way — new photos must go through
    //   galleryRequests. "Shrinks" = every URL in the proposed array
    //   already existed in the stored array; no new URL sneaks in.
    function galleryOnlyShrinks() {
      return resource.data.gallery is list &&
        request.resource.data.gallery is list &&
        resource.data.gallery.hasAll(request.resource.data.gallery);
    }
    function therapistGallerySelfRemoval() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['gallery', 'updatedAt', 'updatedBy']) &&
        galleryOnlyShrinks();
    }

    // 🆕 28s387 — anonymous profile-view counter. Anyone may bump viewCount,
    // but ONLY viewCount, and ONLY to the current value + 1 (missing => 0).
    // Can't write arbitrary values or touch any other field, so it's safe to
    // expose to unauthenticated visitors.
    function isViewCountBump() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
        && request.resource.data.viewCount is int
        && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1;
    }

    // 🆕 Round 28x.113 (founder: "ทำระบบนับวิวแยกรายรูปจริงๆ") — per-photo view
    // counters, one doc per photo in therapists/{id}/photoViews/{photoKey}.
    // Same shape as isViewCountBump() above, just split into create (first
    // view of a photo — doc doesn't exist yet) and update (every view after)
    // since a subcollection doc can't rely on `resource.data.get(...)`
    // defaulting for a field that has never existed on ANY doc at that path.
    function isPhotoViewCreate() {
      return request.resource.data.keys().hasOnly(['src', 'views', 'updatedAt'])
        && request.resource.data.src is string
        && request.resource.data.views == 1;
    }
    function isPhotoViewBump() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'updatedAt'])
        && request.resource.data.views is int
        && request.resource.data.views == resource.data.get('views', 0) + 1;
    }

    // ── admins ─────────────────────────────────────────────────────
    // Self-read is allowed (so LoginPage can check isAdmin via direct
    // doc read without leaking other admins' info), peer-admin can
    // read the full collection. Writes only via Firebase Console
    // (or an Admin SDK script with service account creds).
    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      allow write: if false;
    }

    // ── users (customer profiles) ──────────────────────────────────
    // Round 28s1: tightened.
    //  • READ: owner + admin only (was public — leaked phone/email/role).
    //  • CREATE: owner only, and `role` must be 'user' or absent
    //    (was open — attacker could pre-create users/<future-uid> with
    //    role:'admin' before signup; setRoleOnSignup merges and the
    //    malicious role wins).
    //  • UPDATE: owner can only change a whitelist of safe profile
    //    fields. `role` is explicitly NOT in the list — closes the
    //    self-promotion-to-admin path that the client trust model relied
    //    on. Admin SDK + Cloud Functions bypass these and remain free.
    function userEditableKeys() {
      return ['displayName', 'phone', 'photoURL', 'language', 'updatedAt'];
    }
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
                    && (!('role' in request.resource.data)
                        || request.resource.data.role == 'user')
                    // 🆕 28x.60 — no signing up AS the shop.
                    && !claimsReservedIdentity(request.resource.data);
      allow update: if isAdmin()
                    || (isOwner(userId)
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(userEditableKeys())
                        // 🆕 28x.60 — nor renaming yourself into the shop later.
                        && !claimsReservedIdentity(request.resource.data));
      allow delete: if isAdmin();
    }

    // ── users/{uid}/favorites ────────────────────────────────────────
    // Saved-therapists list (src/pages/user/SavedTherapistsPage.tsx).
    // Owner-only subcollection — a rule on the parent /users/{userId}
    // doc does NOT cascade to subcollections, so this was previously
    // unreachable (read denied) even though the page and its query
    // already existed.
    match /users/{userId}/favorites/{favoriteId} {
      allow read, write: if isOwner(userId);
    }

    // ── therapists ─────────────────────────────────────────────────
    // Public read (catalog). Self-service updates are limited to a
    // whitelist of fields; everything else is admin-only.
    match /therapists/{therapistId} {
      allow read: if true;
      allow create: if isAdmin();

      allow update: if isAdmin() ||
                    (isTherapistOwner(therapistId) &&
                     therapistUpdateIsSelfEditable()) ||
                    (isTherapistOwner(therapistId) &&
                     therapistGallerySelfRemoval()) ||
                    isViewCountBump();

      allow delete: if isAdmin();
    }

    // ── therapists/{id}/photoViews ───────────────────────────────────
    // 🆕 Round 28x.113 — per-photo view counters (see isPhotoViewCreate/Bump
    // above). Public read (the count is shown on the public Photos tab,
    // same visibility as the photos themselves); anonymous visitors may
    // create the first-view doc or bump an existing one by exactly +1 —
    // same anonymous-write shape isViewCountBump() already allows on the
    // parent doc, just scoped per photo. A subcollection rule does NOT
    // inherit from its parent match block (see the /users/{uid}/favorites
    // comment above), so this needs its own explicit block.
    match /therapists/{therapistId}/photoViews/{photoKey} {
      allow read: if true;
      allow create: if isPhotoViewCreate();
      allow update: if isPhotoViewBump();
      allow delete: if isAdmin();
    }

    // ── services ───────────────────────────────────────────────────
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── bookings ───────────────────────────────────────────────────
    // Round 28s1: tightened. Was `allow read: if true` which exposed
    // every customer's phone/address/hotel room/name to anonymous
    // callers. Now:
    //  • GET (single doc by ID) stays public — BookingSuccessPage
    //    needs anonymous read after guest checkout, and Firestore
    //    auto IDs (20 char base64-ish) are not feasibly guessable.
    //  • LIST/query restricted to owner/therapist/admin. Client
    //    queries (BookingHistoryPage, useTherapistBookings, etc.)
    //    MUST filter by `userId == auth.uid` or `therapistId ==
    //    auth.uid` so each returned doc satisfies the rule.
    //  • CREATE stays open for guest checkout but status whitelist
    //    keeps customers from creating pre-marked-paid bookings.
    //  • UPDATE: customer can only touch a cancel-related field
    //    whitelist (no flipping their own booking to status=paid
    //    or modifying totalPrice). Therapist can only update
    //    operational fields (status/arrived/completed). Admin
    //    unrestricted.
    function customerBookingEditableKeys() {
      return ['status', 'note', 'cancelledAt', 'cancelReason', 'updatedAt'];
    }
    function therapistBookingEditableKeys() {
      return ['status', 'arrivedAt', 'completedAt', 'therapistNote', 'updatedAt'];
    }
    match /bookings/{bookingId} {
      // 🆕 28x.65 — was `allow get: if true`, which let anyone holding a 20-char
      //   doc id read a guest's address, phone and GPS without signing in. It
      //   existed for one flow: an unauthenticated guest on
      //   /booking/success/:id after checkout.
      //
      //   That flow now goes through the `getBookingPublic` callable, which
      //   verifies a capability token minted at booking time and returns a
      //   redacted document. Rules can't check a client-supplied secret on a
      //   read, which is why the guest path lives in a function and this rule
      //   can be reduced to real ownership.
      allow get: if isAdmin()
                 || (isSignedIn() && resource.data.userId == request.auth.uid)
                 || isAssignedTherapist();
      // Round 28s6 (founder 2026-05-30) — the 28s1 rule denied public
      // review listeners. Reviews live on bookings (reviewText / rating
      // fields on the same doc as the original reservation). Allow
      // public list ONLY when every returned doc carries a rating —
      // pair with a `where('rating','>=',1)` filter in the client
      // listener so un-rated bookings (which still hold PII) stay
      // private. Long-term: denormalise reviews into a separate
      // `public_reviews` collection so we don't lean on the rated
      // bookings still exposing phone/address; tracked as a follow-up.
      // 🆕 Round 28w.91 — the `rating is number` type-check was silently killing
      //   this rule. For a LIST, Firestore must PROVE from the query's own
      //   constraints that every doc it could return is permitted; it evaluates
      //   the rule against the query, not the documents. A client filter of
      //   where('rating','>=',1) proves `resource.data.rating >= 1`, but nothing
      //   in the query proves the field's TYPE — so the clause could never be
      //   satisfied and every guest got permission-denied. That is why reviews
      //   were invisible to logged-out visitors even though the rule "looked"
      //   correct. The inequality alone is the guard, and it is the one the
      //   client actually asserts.
      // 🔴 Round 28w.91 — PUBLIC LIST REMOVED. Making rated bookings publicly
      //   listable DOES work (the `rating is number` type-check was what broke
      //   it), but it hands every anonymous visitor the whole booking document —
      //   and a booking carries `address`, `phone`, `location` {lat,lng} and
      //   `note`. Verified against production: a logged-out request returned a
      //   real guest's home address, phone number and GPS coordinates.
      //
      //   For an outcall business whose entire promise is discretion, that is a
      //   far worse outcome than reviews being invisible. Reviews must come from
      //   a separate collection holding ONLY rating + text (see /reviewsPublic
      //   below) — never from the reservation document.
      allow list: if isAdmin()
                  || (isSignedIn() && resource.data.userId == request.auth.uid)
                  || isAssignedTherapist();
      // 🆕 28x.60 — plus: may not claim the shop's own name/number. This is the
      //   only unforgeable place to enforce it; the booking page's check is UX.
      // 🆕 28x.107 (founder security audit) — plus a SHAPE + SIZE gate.
      //   Create here is deliberately unauthenticated and stays that way: a
      //   guest reserves before they ever hold an account, and forcing sign-up
      //   first would cost more real bookings than it prevents fake ones.
      //   But "unauthenticated" was also "unbounded" — the only thing a
      //   scripted flood had to satisfy was a status string, so it could write
      //   megabyte documents as fast as the SDK allowed. This is the exact
      //   "คู่แข่งแกล้ง" vector: a competitor can't be stopped from placing a
      //   plausible fake booking (the concierge-confirm step is what catches
      //   those, by design), but they SHOULDN'T be able to make each one cheap
      //   AND enormous.
      //
      //   What this cannot do is rate-limit — Firestore rules have no counter.
      //   That needs App Check; see the note on enforceAppCheck in
      //   functions/src/index.ts. This narrows the blast radius meanwhile.
      allow create: if request.resource.data.status in ['pending', 'confirmed']
                    && !claimsReservedIdentity(request.resource.data)
                    && (isAdmin() || isSaneBookingPayload(request.resource.data));
      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.userId == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(customerBookingEditableKeys()))
                    || (isSignedIn()
                        && resource.data.therapistId == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(therapistBookingEditableKeys()));
      allow delete: if isAdmin();
    }

    // ── booking chat (28x.140) ─────────────────────────────────────
    // Founder: "ต้องจองแล้วเท่านั้นถึงจะแชทกับพนักงานเพื่อคอนเฟิร์มออเดอได้".
    // The thread hangs off the reservation itself, so "has booked" isn't a
    // flag we check — it's the only path that can address a document here.
    //
    // Three identities may be in the room, and each proves itself differently:
    //   • the GUEST — usually not signed in at all. She holds the same
    //     capability token minted at checkout that `getBookingPublic` verifies
    //     (28x.65). Rules can't read a client-supplied secret, so the
    //     `claimBookingChat` callable checks it and mints a custom token
    //     carrying `bookingChat: <bookingId>`. That claim is what this rule
    //     reads — the secret never reaches Firestore.
    //   • the assigned PRACTITIONER — uid-to-uid against `therapistUid`, the
    //     same field `isAssignedTherapist()` uses (28x.66).
    //   • ADMIN — always, so a thread can never become a channel View can't see.
    //
    // The guest branch is checked FIRST on purpose: it's the common case and
    // it costs no document read, so the get() below only runs for staff.
    function chatBooking(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
    }
    function isChatGuest(bookingId) {
      return isSignedIn() && request.auth.token.bookingChat == bookingId;
    }
    function isChatMember(bookingId) {
      return isChatGuest(bookingId)
             || isAdmin()
             || (isSignedIn() && chatBooking(bookingId).userId == request.auth.uid)
             || (isSignedIn() && chatBooking(bookingId).therapistUid == request.auth.uid);
    }
    // 🚨 HOTFIX (audit) — the two kill switches on adminSettings/advanced
    //   were only ever read inside the claimBookingChat CALLABLE (which gates
    //   the guest's token exchange) and the Telegram-DM trigger — never here,
    //   the actual write gate. Flipping bookingChatEnabled:false ("whole
    //   feature") left admin and the practitioner able to keep writing,
    //   because their panels never call claimBookingChat at all (28x.153's
    //   staff branch skips the claim exchange entirely). Flipping
    //   bookingChatTherapistEnabled:false ("thread stays open with the
    //   concierge alone") didn't stop the practitioner from sending either —
    //   nothing here depended on it. Both defaults stay ON (missing field ⇒
    //   `!= false` ⇒ true), matching the documented default.
    function bookingChatEnabled() {
      let path = /databases/$(database)/documents/adminSettings/advanced;
      return !exists(path) || get(path).data.bookingChatEnabled != false;
    }
    function bookingChatTherapistEnabled() {
      let path = /databases/$(database)/documents/adminSettings/advanced;
      return !exists(path) || get(path).data.bookingChatTherapistEnabled != false;
    }
    // A sender may only speak AS the identity they actually proved. Without
    // this a guest could post a message labelled `sender: 'therapist'` and the
    // panel would render it in the practitioner's own bubble style.
    function chatSenderOk(bookingId) {
      return bookingChatEnabled() && (
             (request.resource.data.sender == 'guest'
              && (isChatGuest(bookingId)
                  || (isSignedIn() && chatBooking(bookingId).userId == request.auth.uid)))
             || (request.resource.data.sender == 'therapist'
                 && bookingChatTherapistEnabled()
                 && isSignedIn()
                 && chatBooking(bookingId).therapistUid == request.auth.uid)
             || (request.resource.data.sender == 'admin' && isAdmin())
      );
    }
    match /bookings/{bookingId}/messages/{messageId} {
      allow read: if isChatMember(bookingId);
      // 🆕 Shape gate, measured against the real client payloads — NOT
      //   estimated. See the 28x.116 regression in CLAUDE.md: a guessed
      //   key-count cap on bookings rejected every real customer checkout for
      //   days. The two senders here write exactly:
      //     guest → {text, sender, createdAt}                     (3 keys)
      //     staff → {text, sender, senderName, createdAt}         (4 keys)
      //   `hasOnly` below is that list verbatim; if a field is ever added to
      //   src/components/chat/BookingChatThread.tsx, it goes here in the SAME
      //   round or every send silently permission-denies.
      allow create: if chatSenderOk(bookingId)
                    && request.resource.data.keys()
                         .hasOnly(['text', 'sender', 'senderName', 'createdAt'])
                    && request.resource.data.keys()
                         .hasAll(['text', 'sender', 'createdAt'])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 1
                    && request.resource.data.text.size() <= 1000
                    // Server clock only — a client-set time would let either
                    // side forge the order of a confirmation exchange.
                    && request.resource.data.createdAt == request.time
                    && (!('senderName' in request.resource.data)
                        || (request.resource.data.senderName is string
                            && request.resource.data.senderName.size() <= 60))
                    // 28x.60 — nobody may sign a message as the shop itself.
                    //   `claimsReservedIdentity()` is deliberately NOT reused
                    //   here: it inspects contactName/customerName/displayName/
                    //   username/userName/phone, none of which exist on a
                    //   message, so calling it would have looked like a guard
                    //   while checking nothing. `senderName` is the byline on
                    //   this document, so that is what gets checked.
                    && (isAdmin()
                        || !('senderName' in request.resource.data)
                        || !isReservedName(request.resource.data.senderName));
      // Immutable: a confirmation exchange nobody can quietly rewrite after
      // the fact is the entire point of putting it here instead of in DMs.
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Thread summary, written ONLY by the onBookingChatMessage function
    // (admin SDK bypasses rules). It exists so the practitioner's job list can
    // show an unread dot from ONE query instead of opening a listener per job.
    // Unread state itself is client-local (last-opened in localStorage), which
    // is why nothing here needs a client write path.
    match /bookingChatMeta/{bookingId} {
      allow get: if isChatMember(bookingId);
      // No get() in the list branch — a rule read would run per document
      // scanned and hit the rules read limit on a long job list.
      allow list: if isAdmin()
                  || (isSignedIn() && resource.data.therapistUid == request.auth.uid);
      allow write: if false;
    }

    // ── reviews ────────────────────────────────────────────────────
    // Round 28s1: tightened. Was open create with only rating-range
    // check — anyone could spam fake 5★ self-praise or 1★ competitor
    // sabotage via the SDK. Now requires sign-in, matching userId,
    // forced status='pending' (so customer can't auto-approve their
    // own review), and a comment size cap to prevent quota abuse.
    // ReviewPage.tsx already gates UX behind login + completed-booking;
    // this just makes the rules match the intent.
    // 🆕 Round 28x.173 — booking-scoped guest review, no account required
    //   (founder: "ทำรีวิวแบบไม่ต้องสมัครหรือเป็นสมาชิกได้ไหม"). Mirrors the
    //   booking-chat guest pattern: claimBookingReview verifies the
    //   checkout accessToken and mints a custom token carrying
    //   `bookingReview: <bookingId>`, which this reads. The reviewId
    //   itself must equal the bookingId — one review per booking is then
    //   just Firestore's own "create fails if the doc already exists"
    //   behavior, no separate dedup query needed.
    function isBookingReviewClaim(bookingId) {
      return isSignedIn() && request.auth.token.bookingReview == bookingId;
    }
    match /reviews/{reviewId} {
      allow read: if true;
      // ⚠️ The two identity branches are wrapped in ONE outer parens group,
      //   deliberately — `&&` binds tighter than `||` here (same as JS), so
      //   without the outer wrap this would parse as
      //   `signedInBranch || (bookingReviewBranch && allTheValidation)`,
      //   letting ANY signed-in user create a review with no rating/status/
      //   comment checks at all as long as the userId matched. Caught before
      //   shipping — exactly the class of bug this file's rules discipline
      //   exists to prevent.
      allow create: if (
                      (
                        isSignedIn()
                        && request.resource.data.userId == request.auth.uid
                        && !('bookingId' in request.resource.data)
                      ) || (
                        request.resource.data.bookingId == reviewId
                        && isBookingReviewClaim(reviewId)
                        && !('userId' in request.resource.data)
                      )
                    )
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.status == 'pending'
                    && (!('comment' in request.resource.data)
                        || (request.resource.data.comment is string
                            && request.resource.data.comment.size() <= 2000))
                    // 🆕 28x.60 — userName is the public byline on the review
                    //   list; a review signed "SunRed" reads as the shop
                    //   vouching for itself.
                    && !claimsReservedIdentity(request.resource.data);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── notifications ──────────────────────────────────────────────
    // Round 28s1: tightened. Was fully public — any attacker could
    // rewrite a victim's `link` field to a phishing URL, or dump
    // every notification in the system. Now:
    //  • READ: owner + admin only.
    //  • CREATE: only by the owning user (BookingFlowPage writes
    //    {userId: user.uid, ...} after auth check). Cloud Functions
    //    use admin SDK and bypass.
    //  • UPDATE: owner can only flip the read flag — link/title/
    //    content stay immutable.
    match /notifications/{notifId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
                    || (isSignedIn()
                        && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.userId == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(['read', 'readAt']));
      allow delete: if isAdmin();
    }

    // ── blocked devices (legacy, unused) / admin settings ───────────
    // 🆕 Round 28s293 — `blockedDevices` was a dead feature: nothing in
    //   the client ever generated or wrote a "deviceId" anywhere else in
    //   the codebase, so admin had no real value to type into the block
    //   dialog and nothing ever checked this collection at booking time.
    //   Replaced with `blockedPhones` below, keyed on the normalized
    //   phone number that's already collected on every booking and
    //   already the CRM's identity key (see AdminUsersPage.tsx). Left
    //   this rule in place (harmless, admin-only) rather than deleting —
    //   AdminBlockedDevicesPage.tsx no longer reads/writes it.
    match /blockedDevices/{deviceId} {
      allow read, write: if isAdmin();
    }

    // 🆕 Round 28s293 — read must be public: guest checkout has no auth
    //   at all (BookingFlowPage writes userId: null for the common case),
    //   so the pre-submit block check has no signed-in user to gate on.
    //   Docs only hold a normalized phone as the ID + a reason string
    //   admin wrote themselves — no customer PII beyond what a phone
    //   number itself already is.
    match /blockedPhones/{phone} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adminSettings/{settingId} {
      allow read, write: if isAdmin();
    }

    // 🆕 Round 28s296 (founder: "admin/advanced-settings ปรับแก้") —
    //   `publicRules` holds ONLY non-secret booking-eligibility flags
    //   (maintenanceMode, minAdvanceMins, maxFutureDays) that the
    //   UNAUTHENTICATED booking flow must read before accepting a
    //   submission (same reasoning as `blockedPhones` above — guest
    //   checkout has no auth to gate a signed-in read on). Deliberately
    //   a SEPARATE doc from `adminSettings/advanced` (which may later
    //   hold real secrets like a bot token) so a public-read grant here
    //   can never accidentally expose something sensitive.
    match /adminSettings/publicRules {
      allow read: if true;
    }

    // 🆕 Round 28s298 (founder: "เพิ่ม เมนู โปรโมชั่น") — one doc per
    //   promo code (builtin on/off override OR a brand-new custom code),
    //   matching `blockedPhones`' shape. Public read: the discount-code
    //   field in checkout has no auth, so BookingFlowPage's client-side
    //   validateDiscount() needs to read this before a guest ever signs
    //   in. Write stays admin-only.
    match /promoCodes/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── reward claims (Anniversary campaign) ────────────────────────
    // 🆕 Round 28w.88 — a guest claims ONE Anniversary reward from the banner
    //   dialog. The claim is a REQUEST, never a grant:
    //     • create — only for yourself, only status "pending". A guest cannot
    //       mint an already-approved claim.
    //     • read   — only your own claims (or admin). Claims carry a userId, so
    //       no public list.
    //     • update/delete — admin only. Approving or marking a reward used is
    //       the concierge's call; the client can never do it.
    //   Note the guest ALSO cannot write the reward onto their own users/{uid}
    //   doc — userEditableKeys() is a whitelist that has no reward field — so
    //   there is no client path to granting yourself anything.
    match /rewardClaims/{claimId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // ── reports (28x.87 — founder: "รายการรีพอร์ต ... ให้ฝั่งลูกค้าคอมเพลนมาได้
    //   แล้วมาขึ้นเตือนพนักงาน") — a customer reporting an issue on a completed
    //   session, routed straight to the practitioner it's about.
    //   • CREATE: signed-in customer only, must stamp their own uid and start
    //     status 'open' (rewardClaims pattern above). Also verified against
    //     the booking itself — bookingId must be a booking the caller OWNS,
    //     and the claimed therapistUid must match that booking's real
    //     therapistUid — otherwise nothing stops a customer from filing a
    //     report against an unrelated therapist she never booked.
    //   • READ: admin, or the therapist it's about. The reporting customer
    //     gets no read-back — there's no "my reports" list, and no reason to
    //     expose the therapist's read/ack state to her.
    //   • UPDATE: the therapist may only flip her OWN report from open to
    //     acknowledged — can't edit the message, can't touch anyone else's.
    //   • DELETE: admin only — reports are a permanent record.
    function reportBooking() {
      return get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data;
    }
    function reportMatchesOwnBooking() {
      return request.resource.data.bookingId is string
        && reportBooking().userId == request.auth.uid
        && reportBooking().get('therapistUid', null) == request.resource.data.get('therapistUid', null);
    }
    function reportTherapistEditableKeys() {
      return ['status', 'acknowledgedAt'];
    }
    match /reports/{reportId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.therapistUid is string
                      && resource.data.therapistUid == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'open'
                    && reportMatchesOwnBooking();
      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.therapistUid is string
                        && resource.data.therapistUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(reportTherapistEditableKeys())
                        && request.resource.data.status == 'acknowledged');
      allow delete: if isAdmin();
    }

    // ── audit log ───────────────────────────────────────────────────
    // 🆕 Round 28s234 (Phase 4) — was write:false ("Cloud Functions only")
    // but nothing server-side ever wrote it, so the collection was
    // permanently empty. Admin actions (confirm/cancel booking, mark
    // payout paid, roster relight) now log directly via logAdminAction()
    // in src/utils/auditLog.ts. Safe: only an authenticated admin can
    // write, and every write must carry their own uid (can't forge
    // another admin's actorId) — a self-owned shop's worst case is an
    // admin misrepresenting their own action, not a real security hole.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false; // append-only
    }

    // ── payouts (Phase 4 — weekly therapist payout tracking) ───────
    match /payouts/{payoutId} {
      allow read, write: if isAdmin();
    }

    // ── payoutAccounts (28s314 — therapists' bank details for the
    //   Pay-Therapists transfer flow). Admin-only: these hold private
    //   bank/account numbers and must NEVER be world-readable like the
    //   `therapists` collection is (allow read: if true). Keyed by the
    //   therapist doc id.
    // 🆕 Round 28x.96 (founder Home quick-menu: "Payout Account ·
    //   บัญชีธนาคาร") — was strictly admin-only. Self-edit added so a
    //   therapist can keep her own payout destination current; the doc ID
    //   equals her `therapists` doc ID, so ownership is checked by reading
    //   THAT doc's uid/email (payoutAccounts docs carry no identity fields
    //   of their own). A Cloud Functions trigger
    //   (notifyPayoutAccountChanged) alerts the admin Report channel on
    //   every write here that wasn't made by an admin — bank-transfer
    //   destination is sensitive enough that View should always know it
    //   changed, even though the write itself is allowed.
    function payoutAccountOwner(therapistId) {
      let t = get(/databases/$(database)/documents/therapists/$(therapistId)).data;
      return isSignedIn() && (
        (t.uid is string && t.uid == request.auth.uid) ||
        (t.email is string && request.auth.token.email is string &&
         t.email == request.auth.token.email)
      );
    }
    function payoutAccountEditableKeys() {
      return ['bankName', 'bankAccount', 'bankAccountName', 'updatedAt', 'updatedBy'];
    }
    match /payoutAccounts/{therapistId} {
      allow read: if isAdmin() || payoutAccountOwner(therapistId);
      allow create: if (isAdmin() || payoutAccountOwner(therapistId))
                    && request.resource.data.keys().hasOnly(payoutAccountEditableKeys());
      allow update: if isAdmin() ||
                    (payoutAccountOwner(therapistId) &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(payoutAccountEditableKeys()));
      allow delete: if isAdmin();
    }

    // 🆕 Round 28x.96 (founder: "ทุกรูปที่อัปโหลดใหม่จะถูกตรวจสอบผ่านแอดมิน
    //   หลังบ้านก่อนเสมอ") — therapist self-service gallery uploads land
    //   here as pending, never touching the live `gallery` array directly.
    //   Admin approves via the "คำขอพนักงาน" panel, which writes the URL
    //   into therapists/{id}.gallery (admin already has full write there).
    // 🚨 HOTFIX (audit) — `therapistUid == request.auth.uid` only proved the
    //   CALLER'S identity; it never checked that `therapistDocId` — the field
    //   admin's approve action actually trusts and writes into via
    //   `arrayUnion` — belongs to that same caller. Any signed-in account
    //   (a therapist OR a plain customer — nothing here required the
    //   "therapist" role either) could file a request naming a DIFFERENT
    //   practitioner's `therapistDocId` plus an attacker-chosen `imageUrl`,
    //   and admin approving it would inject that image straight into a
    //   stranger's live public gallery with no way to spot the spoof.
    //   isTherapistOwnerById() below does a real cross-document lookup —
    //   the same 3-way (docId / uid field / email) ownership match already
    //   used for editing a therapist's own profile — so `therapistDocId`
    //   must genuinely resolve back to the caller, not just be self-reported.
    function isTherapistOwnerById(therapistId) {
      let tPath = /databases/$(database)/documents/therapists/$(therapistId);
      return isSignedIn() && exists(tPath) && (
        request.auth.uid == therapistId ||
        (get(tPath).data.uid is string && get(tPath).data.uid == request.auth.uid) ||
        (get(tPath).data.email is string && request.auth.token.email is string &&
         get(tPath).data.email == request.auth.token.email)
      );
    }
    match /galleryRequests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.therapistUid == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.therapistUid == request.auth.uid
                    && request.resource.data.therapistDocId is string
                    && isTherapistOwnerById(request.resource.data.therapistDocId)
                    && request.resource.data.status == 'pending'
                    && request.resource.data.imageUrl is string
                    // 🆕 Round 28x.174 (founder: "โปรไฟล์พนักงาน มีแค่รูป
                    //   ให้เพิ่มวิดีโอได้") — optional so every existing/
                    //   historical request (all photos, filed before this
                    //   field existed) keeps working unchanged; absent ==
                    //   "image" everywhere this gets read.
                    && (!('mediaType' in request.resource.data)
                        || request.resource.data.mediaType in ['image', 'video']);
      // Only admin resolves a request (approve/reject) — the therapist
      // filed it and waits; she may still withdraw it herself below.
      allow update: if isAdmin();
      allow delete: if isAdmin() ||
                    (isSignedIn() && resource.data.therapistUid == request.auth.uid &&
                     resource.data.status == 'pending');
    }

    // 🆕 Round 28x.97 (founder: "สนใจ" — self-service edit of Telegram bot
    //   message content) — admin-only from the CLIENT side. Cloud Functions
    //   read this via firebase-admin (functions/src/botCopyStore.ts), which
    //   bypasses these rules entirely — this block only gates the admin
    //   panel's own read/write, not the bots' ability to read their copy.
    match /botCopy/{docId} {
      allow read, write: if isAdmin();
    }

    // 🆕 Round 28b21 (founder 2026-05-04) — Phase 3 of conversion plan.
    // ── adminPresence (heartbeat doc for "Admin online" badge) ────
    // Single doc `adminPresence/global` written by AdminLayout every
    // 30 seconds. Public read so customer surfaces (BookingSuccess,
    // HeroSection) can light up the green pill. Only signed-in admins
    // may write; rules enforce server-side accuracy.
    match /adminPresence/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 🆕 Round 28b21 — Phase 4 of conversion plan.
    // ── abandoned_bookings (cart abandonment recovery) ────────────
    // Customer browser writes a partial booking when they fill the
    // contact form but haven't submitted. The recoverAbandonedBookings
    // scheduled function reads docs >15 min stale and pings admin.
    // Public create + self-update so guest carts work (no auth at
    // checkout-fill stage). Admin reads/lists for follow-up.
    match /abandoned_bookings/{cartId} {
      allow read: if isAdmin();
      // 🆕 28x.60 — the cart snapshot carries the same free-text contactName
      //   and phone as the booking, is written BEFORE submit, and is shown on
      //   the admin follow-up screen. Same reserved-identity guard, or the
      //   booking-create block is just a wall with a door beside it.
      allow create: if !claimsReservedIdentity(request.resource.data);
      allow update: if !claimsReservedIdentity(request.resource.data); // browser bumps lastActivityAt as user types
      allow delete: if isAdmin();
    }

    // 🆕 Round 28b21 — Phase 3.
    // ── telegramLogs (server-only audit trail) ────────────────────
    match /telegramLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // populated by Cloud Functions only
    }

    // 🆕 Round 28r18 (founder 2026-05-07) — booking-flow error capture.
    // ── booking_errors (admin triage of failed reservations) ──────
    // Customer browser writes one doc per failed booking submit so
    // admin can see WHY "tried to reserve online but doesn't work"
    // without needing repro steps. Public CREATE so anonymous guests
    // can log; admin-only READ; immutable (no update/delete) so the
    // log can't be tampered with.
    // 🆕 28x.107 — `allow create: if true` meant an unauthenticated caller
    //   could write arbitrarily large documents into an admin-read-only
    //   collection, forever, and nobody would look at it until the bill
    //   arrived. Same posture as bookings above: keep the door open (the
    //   whole point is capturing failures from guests who never signed in),
    //   but bound what fits through it.
    match /booking_errors/{eventId} {
      allow read: if isAdmin();
    //   ⚠️ Field names below are the ones src/utils/bookingError.ts actually
    //   writes (errorName / errorMessage / errorStack — NOT message/stack).
    //   A cap on a key that is never written is a cap on nothing; this is the
    //   same class of silent no-op as the analytics_events allow-list drift
    //   in 28x.99. Caps sit just above that file's own TRUNC() limits.
      allow create: if request.resource.data.keys().size() <= 30
                    && strOk(request.resource.data, 'errorName', 400)
                    && strOk(request.resource.data, 'errorMessage', 2000)
                    && strOk(request.resource.data, 'errorStack', 3000)
                    && strOk(request.resource.data, 'userAgent', 800)
                    && strOk(request.resource.data, 'step', 100);
      allow update, delete: if false;
    }

    // 🆕 Round 28r13 (founder 2026-05-06) — funnel analytics.
    // ── analytics_events (self-hosted funnel tracking) ────────────
    // Public CREATE so guest sessions can fire events without auth.
    // Validates the event name against the allow-list to keep the
    // collection clean. Immutable (no update/delete) so the audit trail
    // can't be tampered with. Only admins read — funnel queries should
    // aggregate on the admin side, never expose event timeline to
    // customers.
    // 🆕 Round 28x.99 — allow-list was stuck at the original 5 events;
    //   therapist_view (28t.14), bundle_view/bundle_reserve_click (28r58),
    //   and referral_tier_applied (28r63) were added to analytics.ts's
    //   FunnelEvent type since, but never here — every create for those
    //   four event types has been silently permission-denied (swallowed
    //   by trackEvent's .catch()) since the day each shipped. This is why
    //   "Top practitioners viewed" has read 0 the whole time, not just
    //   "forward-only, no history yet" as the dashboard caption assumed.
    match /analytics_events/{eventId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.event in [
        'home_view',
        'service_view',
        'therapist_view',
        'booking_start',
        'booking_complete',
        'concierge_chat_open',
        'bundle_view',
        'bundle_reserve_click',
        'referral_tier_applied'
      ]
      // 🆕 28x.107 — the allow-list bounds WHICH events land here but not how
      //   big each one is, and this is the highest-volume open-create
      //   collection on the site. Cap the document so a flood is at least a
      //   cheap flood.
      //   Field names are the ones analytics.ts actually writes — `sid`, not
      //   `sessionId`. Verified against the addDoc call, not guessed.
      && request.resource.data.keys().size() <= 25
      && strOk(request.resource.data, 'path', 500)
      && strOk(request.resource.data, 'referrer', 500)
      && strOk(request.resource.data, 'sid', 100)
      && strOk(request.resource.data, 'utmSource', 200)
      && strOk(request.resource.data, 'lang', 20);
      allow update, delete: if false;
    }

    // ── default deny ───────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
