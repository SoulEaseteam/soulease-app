rules_version = '2';

// ⚠️ MVP RULES — relaxed สำหรับให้ระบบ work ก่อน
// TODO: tighten กลับเมื่อตั้ง App Check + Anonymous Auth ทำงานเต็มที่

service cloud.firestore {
  match /databases/{database}/documents {

    // helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // admins — read by self, write only via Console
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // users — public-create (ตอนสมัคร), read/update self, admin manages
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // therapists — public read (catalog), admin manages
    match /therapists/{therapistId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isOwner(therapistId) || isAdmin();
      allow delete: if isAdmin();
    }

    // services — public read
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // bookings — public create (guest booking), public read (admin/therapist filter ใน UI)
    // ⚠️ ปลอดภัยพอสำหรับ MVP — admin เห็น booking ทุกอันใน admin panel
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if request.resource.data.status in ['pending', 'confirmed'];
      allow update: if isAdmin()
                    || (isSignedIn() && resource.data.therapistId == request.auth.uid)
                    || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // reviews — public read, public create
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // notifications — admin only
    match /notifications/{notifId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // blockedDevices — admin only
    match /blockedDevices/{deviceId} {
      allow read, write: if isAdmin();
    }

    // adminSettings — admin only
    match /adminSettings/{settingId} {
      allow read, write: if isAdmin();
    }

    // default deny อื่นๆ
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
