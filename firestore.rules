rules_version = '2';

// 🔐 SunRed Firestore Rules — Round 28s1 (founder 2026-05-30)
//
// Round 28s1 — security hardening (audit found critical PII leak):
//   • bookings: public LIST closed (was open) — now owner/therapist/admin
//     filtered. Single-doc GET still open so guest success page works
//     by random doc ID.
//   • users: public READ closed; CREATE/UPDATE banned from touching `role`
//     (was open — any customer could self-promote to admin).
//   • reviews.CREATE now requires auth + matching userId + status='pending'
//     (was anonymous — anyone could spam fake reviews via SDK).
//   • notifications: locked to per-user read/create/update with hasOnly()
//     on read flag (was fully public — phishing-link rewrite risk).
//   • bookings.UPDATE field whitelist per role (customer can only cancel;
//     therapist can only update status/arrival; admin unrestricted).
//
// Goal: lock therapist self-service to a small set of "safe" fields,
//       keep sensitive things (rating / reviews / totalSessions /
//       isBooked / credentials / badge) as admin-only writes, and
//       still let customers read the public catalog.
//
// Roles
//   • Admin   — entry exists in /admins/{uid}.
//   • Therapist owner — auth.uid matches the doc id, OR the doc's
//                       `uid` field, OR the doc's `email` field.
//   • Customer / guest — anyone else (signed-in or not).
//
// MVP-friendly: bookings/reviews still allow public-create with
// minimal validation so guest checkout works. Tighten when App Check
// + Anonymous Auth are fully wired.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ────────────────────────────────────────────────────
    function isSignedIn() { return request.auth != null; }

    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ── reserved shop identity (28x.60) ───────────────────────────
    // Founder: "บล๊อค ชื่อ และเบอร์ นี้ ห้าม ใครแอบอ้าง" — nobody may write the
    // shop's own name or number onto a booking, profile or review. A guest
    // "SunRed" with the shop's number on a 2am dispatch card is the exact
    // shape a social-engineering attempt takes against an outcall business.
    //
    // Rules-language has no phone normalisation, so this catches the
    // CANONICAL forms only: any string containing the subscriber digits
    // (covers 0634350987, +66634350987, 66634350987) and any casing of
    // "sunred". Separator-laden variants ("063-435-0987") are caught by the
    // client check in src/config/reservedIdentity.ts, which normalises
    // properly. Coarse here, but unforgeable — the client check is not.
    //
    // ⚠️ KEEP IN SYNC with src/config/reservedIdentity.ts.
    // Both are matches() — deliberately no anchors, so a substring hit is
    // enough and a typo can't accidentally widen this into a deny-all.
    function isReservedName(v) {
      return v is string && v.lower().matches('.*sunred.*');
    }
    function isReservedPhone(v) {
      return v is string && v.matches('.*634350987.*');
    }
    /** True when an incoming write claims the shop's identity. Admins are
     *  exempt — View's own account legitimately carries both. */
    function claimsReservedIdentity(d) {
      return !isAdmin() && (
        (('contactName'  in d) && isReservedName(d.contactName))
        || (('customerName' in d) && isReservedName(d.customerName))
        || (('displayName'  in d) && isReservedName(d.displayName))
        || (('username'     in d) && isReservedName(d.username))
        || (('userName'     in d) && isReservedName(d.userName))
        || (('phone'        in d) && isReservedPhone(d.phone))
      );
    }

    /** True if the signed-in user owns this therapist doc.
     *  Matches by docId, by `uid` field, or by `email` field. */
    function isTherapistOwner(therapistId) {
      return isSignedIn() && (
        request.auth.uid == therapistId ||
        (resource.data.uid is string && resource.data.uid == request.auth.uid) ||
        (resource.data.email is string &&
         request.auth.token.email is string &&
         resource.data.email == request.auth.token.email)
      );
    }

    /** Whitelist of fields a therapist may edit on their own profile.
     *  Anything outside this list = admin-only. */
    function therapistEditableKeys() {
      return [
        // status / availability self-service
        'statusOverride', 'isHoliday', 'busyUntil', 'activeBooking',
        // working hours
        'startTime', 'endTime',
        // location
        'currentLocation', 'homeLocation', 'lat', 'lng', 'area',
        // media
        'image', 'gallery',
        // soft profile
        'features', 'specialty', 'servicesAvailable', 'services',
        'bios', 'bioGeneratedAt',
        // 🆕 Round 28b27 — Telegram notification opt-in. Therapist
        //   themselves DM the bot to register and updates this field.
        'telegramChatId',
        // bookkeeping (audit metadata — read by Functions trigger)
        'updatedAt', 'updatedBy'
      ];
    }

    /** True if the proposed update only touches whitelisted keys. */
    function therapistUpdateIsSelfEditable() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly(therapistEditableKeys());
    }

    // 🆕 28s387 — anonymous profile-view counter. Anyone may bump viewCount,
    // but ONLY viewCount, and ONLY to the current value + 1 (missing => 0).
    // Can't write arbitrary values or touch any other field, so it's safe to
    // expose to unauthenticated visitors.
    function isViewCountBump() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
        && request.resource.data.viewCount is int
        && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1;
    }

    // ── admins ─────────────────────────────────────────────────────
    // Self-read is allowed (so LoginPage can check isAdmin via direct
    // doc read without leaking other admins' info), peer-admin can
    // read the full collection. Writes only via Firebase Console
    // (or an Admin SDK script with service account creds).
    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      allow write: if false;
    }

    // ── users (customer profiles) ──────────────────────────────────
    // Round 28s1: tightened.
    //  • READ: owner + admin only (was public — leaked phone/email/role).
    //  • CREATE: owner only, and `role` must be 'user' or absent
    //    (was open — attacker could pre-create users/<future-uid> with
    //    role:'admin' before signup; setRoleOnSignup merges and the
    //    malicious role wins).
    //  • UPDATE: owner can only change a whitelist of safe profile
    //    fields. `role` is explicitly NOT in the list — closes the
    //    self-promotion-to-admin path that the client trust model relied
    //    on. Admin SDK + Cloud Functions bypass these and remain free.
    function userEditableKeys() {
      return ['displayName', 'phone', 'photoURL', 'language', 'updatedAt'];
    }
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
                    && (!('role' in request.resource.data)
                        || request.resource.data.role == 'user')
                    // 🆕 28x.60 — no signing up AS the shop.
                    && !claimsReservedIdentity(request.resource.data);
      allow update: if isAdmin()
                    || (isOwner(userId)
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(userEditableKeys())
                        // 🆕 28x.60 — nor renaming yourself into the shop later.
                        && !claimsReservedIdentity(request.resource.data));
      allow delete: if isAdmin();
    }

    // ── therapists ─────────────────────────────────────────────────
    // Public read (catalog). Self-service updates are limited to a
    // whitelist of fields; everything else is admin-only.
    match /therapists/{therapistId} {
      allow read: if true;
      allow create: if isAdmin();

      allow update: if isAdmin() ||
                    (isTherapistOwner(therapistId) &&
                     therapistUpdateIsSelfEditable()) ||
                    isViewCountBump();

      allow delete: if isAdmin();
    }

    // ── services ───────────────────────────────────────────────────
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── bookings ───────────────────────────────────────────────────
    // Round 28s1: tightened. Was `allow read: if true` which exposed
    // every customer's phone/address/hotel room/name to anonymous
    // callers. Now:
    //  • GET (single doc by ID) stays public — BookingSuccessPage
    //    needs anonymous read after guest checkout, and Firestore
    //    auto IDs (20 char base64-ish) are not feasibly guessable.
    //  • LIST/query restricted to owner/therapist/admin. Client
    //    queries (BookingHistoryPage, useTherapistBookings, etc.)
    //    MUST filter by `userId == auth.uid` or `therapistId ==
    //    auth.uid` so each returned doc satisfies the rule.
    //  • CREATE stays open for guest checkout but status whitelist
    //    keeps customers from creating pre-marked-paid bookings.
    //  • UPDATE: customer can only touch a cancel-related field
    //    whitelist (no flipping their own booking to status=paid
    //    or modifying totalPrice). Therapist can only update
    //    operational fields (status/arrived/completed). Admin
    //    unrestricted.
    function customerBookingEditableKeys() {
      return ['status', 'note', 'cancelledAt', 'cancelReason', 'updatedAt'];
    }
    function therapistBookingEditableKeys() {
      return ['status', 'arrivedAt', 'completedAt', 'therapistNote', 'updatedAt'];
    }
    match /bookings/{bookingId} {
      allow get: if true;
      // Round 28s6 (founder 2026-05-30) — the 28s1 rule denied public
      // review listeners. Reviews live on bookings (reviewText / rating
      // fields on the same doc as the original reservation). Allow
      // public list ONLY when every returned doc carries a rating —
      // pair with a `where('rating','>=',1)` filter in the client
      // listener so un-rated bookings (which still hold PII) stay
      // private. Long-term: denormalise reviews into a separate
      // `public_reviews` collection so we don't lean on the rated
      // bookings still exposing phone/address; tracked as a follow-up.
      // 🆕 Round 28w.91 — the `rating is number` type-check was silently killing
      //   this rule. For a LIST, Firestore must PROVE from the query's own
      //   constraints that every doc it could return is permitted; it evaluates
      //   the rule against the query, not the documents. A client filter of
      //   where('rating','>=',1) proves `resource.data.rating >= 1`, but nothing
      //   in the query proves the field's TYPE — so the clause could never be
      //   satisfied and every guest got permission-denied. That is why reviews
      //   were invisible to logged-out visitors even though the rule "looked"
      //   correct. The inequality alone is the guard, and it is the one the
      //   client actually asserts.
      // 🔴 Round 28w.91 — PUBLIC LIST REMOVED. Making rated bookings publicly
      //   listable DOES work (the `rating is number` type-check was what broke
      //   it), but it hands every anonymous visitor the whole booking document —
      //   and a booking carries `address`, `phone`, `location` {lat,lng} and
      //   `note`. Verified against production: a logged-out request returned a
      //   real guest's home address, phone number and GPS coordinates.
      //
      //   For an outcall business whose entire promise is discretion, that is a
      //   far worse outcome than reviews being invisible. Reviews must come from
      //   a separate collection holding ONLY rating + text (see /reviewsPublic
      //   below) — never from the reservation document.
      allow list: if isAdmin()
                  || (isSignedIn() && resource.data.userId == request.auth.uid)
                  || (isSignedIn() && resource.data.therapistId == request.auth.uid);
      // 🆕 28x.60 — plus: may not claim the shop's own name/number. This is the
      //   only unforgeable place to enforce it; the booking page's check is UX.
      allow create: if request.resource.data.status in ['pending', 'confirmed']
                    && !claimsReservedIdentity(request.resource.data);
      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.userId == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(customerBookingEditableKeys()))
                    || (isSignedIn()
                        && resource.data.therapistId == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(therapistBookingEditableKeys()));
      allow delete: if isAdmin();
    }

    // ── reviews ────────────────────────────────────────────────────
    // Round 28s1: tightened. Was open create with only rating-range
    // check — anyone could spam fake 5★ self-praise or 1★ competitor
    // sabotage via the SDK. Now requires sign-in, matching userId,
    // forced status='pending' (so customer can't auto-approve their
    // own review), and a comment size cap to prevent quota abuse.
    // ReviewPage.tsx already gates UX behind login + completed-booking;
    // this just makes the rules match the intent.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.status == 'pending'
                    && (!('comment' in request.resource.data)
                        || (request.resource.data.comment is string
                            && request.resource.data.comment.size() <= 2000))
                    // 🆕 28x.60 — userName is the public byline on the review
                    //   list; a review signed "SunRed" reads as the shop
                    //   vouching for itself.
                    && !claimsReservedIdentity(request.resource.data);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── notifications ──────────────────────────────────────────────
    // Round 28s1: tightened. Was fully public — any attacker could
    // rewrite a victim's `link` field to a phishing URL, or dump
    // every notification in the system. Now:
    //  • READ: owner + admin only.
    //  • CREATE: only by the owning user (BookingFlowPage writes
    //    {userId: user.uid, ...} after auth check). Cloud Functions
    //    use admin SDK and bypass.
    //  • UPDATE: owner can only flip the read flag — link/title/
    //    content stay immutable.
    match /notifications/{notifId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
                    || (isSignedIn()
                        && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.userId == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(['read', 'readAt']));
      allow delete: if isAdmin();
    }

    // ── blocked devices (legacy, unused) / admin settings ───────────
    // 🆕 Round 28s293 — `blockedDevices` was a dead feature: nothing in
    //   the client ever generated or wrote a "deviceId" anywhere else in
    //   the codebase, so admin had no real value to type into the block
    //   dialog and nothing ever checked this collection at booking time.
    //   Replaced with `blockedPhones` below, keyed on the normalized
    //   phone number that's already collected on every booking and
    //   already the CRM's identity key (see AdminUsersPage.tsx). Left
    //   this rule in place (harmless, admin-only) rather than deleting —
    //   AdminBlockedDevicesPage.tsx no longer reads/writes it.
    match /blockedDevices/{deviceId} {
      allow read, write: if isAdmin();
    }

    // 🆕 Round 28s293 — read must be public: guest checkout has no auth
    //   at all (BookingFlowPage writes userId: null for the common case),
    //   so the pre-submit block check has no signed-in user to gate on.
    //   Docs only hold a normalized phone as the ID + a reason string
    //   admin wrote themselves — no customer PII beyond what a phone
    //   number itself already is.
    match /blockedPhones/{phone} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adminSettings/{settingId} {
      allow read, write: if isAdmin();
    }

    // 🆕 Round 28s296 (founder: "admin/advanced-settings ปรับแก้") —
    //   `publicRules` holds ONLY non-secret booking-eligibility flags
    //   (maintenanceMode, minAdvanceMins, maxFutureDays) that the
    //   UNAUTHENTICATED booking flow must read before accepting a
    //   submission (same reasoning as `blockedPhones` above — guest
    //   checkout has no auth to gate a signed-in read on). Deliberately
    //   a SEPARATE doc from `adminSettings/advanced` (which may later
    //   hold real secrets like a bot token) so a public-read grant here
    //   can never accidentally expose something sensitive.
    match /adminSettings/publicRules {
      allow read: if true;
    }

    // 🆕 Round 28s298 (founder: "เพิ่ม เมนู โปรโมชั่น") — one doc per
    //   promo code (builtin on/off override OR a brand-new custom code),
    //   matching `blockedPhones`' shape. Public read: the discount-code
    //   field in checkout has no auth, so BookingFlowPage's client-side
    //   validateDiscount() needs to read this before a guest ever signs
    //   in. Write stays admin-only.
    match /promoCodes/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── reward claims (Anniversary campaign) ────────────────────────
    // 🆕 Round 28w.88 — a guest claims ONE Anniversary reward from the banner
    //   dialog. The claim is a REQUEST, never a grant:
    //     • create — only for yourself, only status "pending". A guest cannot
    //       mint an already-approved claim.
    //     • read   — only your own claims (or admin). Claims carry a userId, so
    //       no public list.
    //     • update/delete — admin only. Approving or marking a reward used is
    //       the concierge's call; the client can never do it.
    //   Note the guest ALSO cannot write the reward onto their own users/{uid}
    //   doc — userEditableKeys() is a whitelist that has no reward field — so
    //   there is no client path to granting yourself anything.
    match /rewardClaims/{claimId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // ── audit log ───────────────────────────────────────────────────
    // 🆕 Round 28s234 (Phase 4) — was write:false ("Cloud Functions only")
    // but nothing server-side ever wrote it, so the collection was
    // permanently empty. Admin actions (confirm/cancel booking, mark
    // payout paid, roster relight) now log directly via logAdminAction()
    // in src/utils/auditLog.ts. Safe: only an authenticated admin can
    // write, and every write must carry their own uid (can't forge
    // another admin's actorId) — a self-owned shop's worst case is an
    // admin misrepresenting their own action, not a real security hole.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false; // append-only
    }

    // ── payouts (Phase 4 — weekly therapist payout tracking) ───────
    match /payouts/{payoutId} {
      allow read, write: if isAdmin();
    }

    // ── payoutAccounts (28s314 — therapists' bank details for the
    //   Pay-Therapists transfer flow). Admin-only: these hold private
    //   bank/account numbers and must NEVER be world-readable like the
    //   `therapists` collection is (allow read: if true). Keyed by the
    //   therapist doc id.
    match /payoutAccounts/{therapistId} {
      allow read, write: if isAdmin();
    }

    // 🆕 Round 28b21 (founder 2026-05-04) — Phase 3 of conversion plan.
    // ── adminPresence (heartbeat doc for "Admin online" badge) ────
    // Single doc `adminPresence/global` written by AdminLayout every
    // 30 seconds. Public read so customer surfaces (BookingSuccess,
    // HeroSection) can light up the green pill. Only signed-in admins
    // may write; rules enforce server-side accuracy.
    match /adminPresence/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 🆕 Round 28b21 — Phase 4 of conversion plan.
    // ── abandoned_bookings (cart abandonment recovery) ────────────
    // Customer browser writes a partial booking when they fill the
    // contact form but haven't submitted. The recoverAbandonedBookings
    // scheduled function reads docs >15 min stale and pings admin.
    // Public create + self-update so guest carts work (no auth at
    // checkout-fill stage). Admin reads/lists for follow-up.
    match /abandoned_bookings/{cartId} {
      allow read: if isAdmin();
      // 🆕 28x.60 — the cart snapshot carries the same free-text contactName
      //   and phone as the booking, is written BEFORE submit, and is shown on
      //   the admin follow-up screen. Same reserved-identity guard, or the
      //   booking-create block is just a wall with a door beside it.
      allow create: if !claimsReservedIdentity(request.resource.data);
      allow update: if !claimsReservedIdentity(request.resource.data); // browser bumps lastActivityAt as user types
      allow delete: if isAdmin();
    }

    // 🆕 Round 28b21 — Phase 3.
    // ── telegramLogs (server-only audit trail) ────────────────────
    match /telegramLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // populated by Cloud Functions only
    }

    // 🆕 Round 28r18 (founder 2026-05-07) — booking-flow error capture.
    // ── booking_errors (admin triage of failed reservations) ──────
    // Customer browser writes one doc per failed booking submit so
    // admin can see WHY "tried to reserve online but doesn't work"
    // without needing repro steps. Public CREATE so anonymous guests
    // can log; admin-only READ; immutable (no update/delete) so the
    // log can't be tampered with.
    match /booking_errors/{eventId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    // 🆕 Round 28r13 (founder 2026-05-06) — funnel analytics.
    // ── analytics_events (self-hosted funnel tracking) ────────────
    // Five-event funnel: home_view / service_view / booking_start /
    // booking_complete / concierge_chat_open. Public CREATE so guest
    // sessions can fire events without auth. Validates the event name
    // against the allow-list to keep the collection clean. Immutable
    // (no update/delete) so the audit trail can't be tampered with.
    // Only admins read — funnel queries should aggregate on the
    // admin side, never expose event timeline to customers.
    match /analytics_events/{eventId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.event in [
        'home_view',
        'service_view',
        'booking_start',
        'booking_complete',
        'concierge_chat_open'
      ];
      allow update, delete: if false;
    }

    // ── default deny ───────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
